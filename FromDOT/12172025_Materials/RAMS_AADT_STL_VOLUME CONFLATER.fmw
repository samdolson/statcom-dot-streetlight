FACTORY_DEF * TeeFactory   FACTORY_NAME "$(LineDivider_WORKSPACE_NAME)_Line1766005134 Input Splitter"   INPUT FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_Line"   OUTPUT FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_Line"
# -------------------------------------------------------------------------
FACTORY_DEF * TestFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_AggregateFilter    INPUT  FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_Line"    TEST @Geometry(IS_COLLECTION) = 1    OUTPUT PASSED FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_AggregateFilter_AGGREGATE"    OUTPUT FAILED FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_AggregateFilter_NOT_AGGREGATE"
# -------------------------------------------------------------------------
MACRO OUTPUT_LINE_FTYPE not_selected
MACRO OUTPUT_LINE_FTYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_LINE
MACRO OUTPUT_ARC_FTYPE not_selected
MACRO OUTPUT_ARC_FTYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_ARC
MACRO OUTPUT_INSTANCE_FTYPE not_selected
Lookup $(LineDivider_WORKSPACE_NAME)_GeometryFilter_RouterTable   ""  "not_selected"   fme_line $(OUTPUT_LINE_FTYPE)   fme_arc $(OUTPUT_ARC_FTYPE)
MACRO COLLECTION_HANDLING NOT_THIS_TIME
MACRO INSTANCE_FILTERING *
INCLUDE [    if 0 {       puts "MACRO COLLECTION_HANDLING *";       if <Unused> {          puts "MACRO INSTANCE_FILTERING NOT_THIS_TIME";       };    };    if {{$(OUTPUT_INSTANCE_FTYPE)} == "not_selected"} {       puts "MACRO INSTANCE_FILTERING NOT_THIS_TIME";    }; ]
FACTORY_DEF * TeeFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_InputPassThrough    INPUT  FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_AggregateFilter_NOT_AGGREGATE"    OUTPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___Input___       @Geometry(FIX_FMETYPE_FMEGEOMETRY)
FACTORY_DEF $(INSTANCE_FILTERING) TestFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_InstanceTest    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___Input___    TEST @Geometry(IS_GEOMETRY_INSTANCE) == 1    OUTPUT PASSED FEATURE_TYPE $(OUTPUT_INSTANCE_FTYPE)    OUTPUT FAILED FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___Input___
FACTORY_DEF $(COLLECTION_HANDLING) TestFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_CollectionTest    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___Input___    TEST &fme_type == "fme_collection"    OUTPUT FAILED FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___Not_Collection___    OUTPUT PASSED FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___Collection___
FACTORY_DEF $(COLLECTION_HANDLING) DeaggregateFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_Deagg    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___Collection___    HOMOGENIZE_COLLECTIONS YES    RECURSIVE YES    SET_FME_TYPE YES    INSTANTIATE_GEOMETRY_INSTANCES_NEW <Unused>    OUTPUT POINT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___HomogeneousAggregate___    OUTPUT LINE FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___HomogeneousAggregate___    OUTPUT POLYGON FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___HomogeneousAggregate___    OUTPUT DONUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___HomogeneousAggregate___    OUTPUT AGGREGATE FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___HomogeneousAggregate___
FACTORY_DEF * TeeFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_RouterPrepper    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___HomogeneousAggregate___    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___Not_Collection___    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___Input___    OUTPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___Prepped___        $(LineDivider_WORKSPACE_NAME)_GeometryFilter_e2148bec_484d_4812_8874_9e3b579379844_targetFeatureType @Lookup($(LineDivider_WORKSPACE_NAME)_GeometryFilter_RouterTable,&fme_type)
FACTORY_DEF * TestFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_Router    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter___Prepped___    TEST @Value($(LineDivider_WORKSPACE_NAME)_GeometryFilter_e2148bec_484d_4812_8874_9e3b579379844_targetFeatureType) != "not_selected"    OUTPUT PASSED FEATURE_TYPE * @FeatureType(@Value($(LineDivider_WORKSPACE_NAME)_GeometryFilter_e2148bec_484d_4812_8874_9e3b579379844_targetFeatureType))                                 @RemoveAttributes($(LineDivider_WORKSPACE_NAME)_GeometryFilter_e2148bec_484d_4812_8874_9e3b579379844_targetFeatureType)    OUTPUT FAILED FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_GeometryFilter_<UNFILTERED>"        @RemoveAttributes($(LineDivider_WORKSPACE_NAME)_GeometryFilter_e2148bec_484d_4812_8874_9e3b579379844_targetFeatureType)
