INCLUDE [    set safeName "[regsub -all {[^a-zA-Z0-9]} {Inspector_2} _]_[expr round(rand() * 1000000)]_[clock clicks  -milliseconds]";    puts "MACRO SAFE_FFS_NAME $safeName"; ]
INCLUDE [    if {{NoReduction} == {NoReduction} &&        {NO_THINNING} == {NO_THINNING}} {       puts "MACRO Inspector_2_6f5ceef6_9d55_49ca_af6c_70f8fe02399e2_LARGE_GEOMETRY_DATA_STORAGE REFERENCE";    } else {       puts "MACRO Inspector_2_6f5ceef6_9d55_49ca_af6c_70f8fe02399e2_LARGE_GEOMETRY_DATA_STORAGE FULL";    }; ]
