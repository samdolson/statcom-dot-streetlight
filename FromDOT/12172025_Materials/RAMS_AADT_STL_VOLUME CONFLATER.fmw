MACRO OUTPUT_POINT_FTYPE not_selected
MACRO OUTPUT_POINT_FTYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_POINT
MACRO OUTPUT_LINE_FTYPE not_selected
MACRO OUTPUT_LINE_FTYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_LINE
MACRO OUTPUT_ARC_FTYPE not_selected
MACRO OUTPUT_ARC_FTYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_ARC
MACRO OUTPUT_INSTANCE_FTYPE not_selected
Lookup $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_RouterTable   ""  "not_selected"   fme_point $(OUTPUT_POINT_FTYPE)   fme_line $(OUTPUT_LINE_FTYPE)   fme_arc $(OUTPUT_ARC_FTYPE)
MACRO COLLECTION_HANDLING NOT_THIS_TIME
MACRO INSTANCE_FILTERING *
INCLUDE [    if 0 {       puts "MACRO COLLECTION_HANDLING *";       if <Unused> {          puts "MACRO INSTANCE_FILTERING NOT_THIS_TIME";       };    };    if {{$(OUTPUT_INSTANCE_FTYPE)} == "not_selected"} {       puts "MACRO INSTANCE_FILTERING NOT_THIS_TIME";    }; ]
FACTORY_DEF * TeeFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_InputPassThrough    INPUT  FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_PythonCaller_OUTPUT"    OUTPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___Input___       @Geometry(FIX_FMETYPE_FMEGEOMETRY)
FACTORY_DEF $(INSTANCE_FILTERING) TestFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_InstanceTest    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___Input___    TEST @Geometry(IS_GEOMETRY_INSTANCE) == 1    OUTPUT PASSED FEATURE_TYPE $(OUTPUT_INSTANCE_FTYPE)    OUTPUT FAILED FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___Input___
FACTORY_DEF $(COLLECTION_HANDLING) TestFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_CollectionTest    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___Input___    TEST &fme_type == "fme_collection"    OUTPUT FAILED FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___Not_Collection___    OUTPUT PASSED FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___Collection___
FACTORY_DEF $(COLLECTION_HANDLING) DeaggregateFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_Deagg    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___Collection___    HOMOGENIZE_COLLECTIONS YES    RECURSIVE YES    SET_FME_TYPE YES    INSTANTIATE_GEOMETRY_INSTANCES_NEW <Unused>    OUTPUT POINT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___HomogeneousAggregate___    OUTPUT LINE FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___HomogeneousAggregate___    OUTPUT POLYGON FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___HomogeneousAggregate___    OUTPUT DONUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___HomogeneousAggregate___    OUTPUT AGGREGATE FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___HomogeneousAggregate___
FACTORY_DEF * TeeFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_RouterPrepper    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___HomogeneousAggregate___    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___Not_Collection___    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___Input___    OUTPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___Prepped___        $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_947881f6_cdb8_4883_b236_c61f69c0c56c5_targetFeatureType @Lookup($(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_RouterTable,&fme_type)
FACTORY_DEF * TestFactory    FACTORY_NAME $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_Router    INPUT FEATURE_TYPE $(LineDivider_WORKSPACE_NAME)_GeometryFilter_2___Prepped___    TEST @Value($(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_947881f6_cdb8_4883_b236_c61f69c0c56c5_targetFeatureType) != "not_selected"    OUTPUT PASSED FEATURE_TYPE * @FeatureType(@Value($(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_947881f6_cdb8_4883_b236_c61f69c0c56c5_targetFeatureType))                                 @RemoveAttributes($(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_947881f6_cdb8_4883_b236_c61f69c0c56c5_targetFeatureType)    OUTPUT FAILED FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_<UNFILTERED>"        @RemoveAttributes($(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_947881f6_cdb8_4883_b236_c61f69c0c56c5_targetFeatureType)
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(LineDivider_WORKSPACE_NAME)_GeometryFilter_2 <UNFILTERED> Transformer Output Nuker"   INPUT FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_<UNFILTERED>"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(LineDivider_WORKSPACE_NAME)_Point1766005134 Output Collector"   INPUT FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_POINT"   OUTPUT FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_Point"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(LineDivider_WORKSPACE_NAME)_Line1766005134 Output Collector"   INPUT FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_LINE"   INPUT FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_GeometryFilter_2_ARC"   OUTPUT FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_Line"
