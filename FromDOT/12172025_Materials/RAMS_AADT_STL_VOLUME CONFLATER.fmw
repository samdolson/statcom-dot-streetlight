FACTORY_DEF {*} AttrSetFactory FACTORY_NAME { $(LineDivider_WORKSPACE_NAME)_AttributeCreator } ATTRSET_PROPAGATE_MISSING YES INPUT  FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_GeometryFilter_LINE"    INPUT  FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_GeometryFilter_ARC" ATTR { __linedivider.dim $($(LineDivider_WORKSPACE_NAME)_DIM$encode) } ATTR { __linedivider.mode $($(LineDivider_WORKSPACE_NAME)_MODE) } ATTR { __linedivider.value <at>Evaluate<openparen>$($(LineDivider_WORKSPACE_NAME)_VALUE$encode)<closeparen> } ATTR { __linedivider.output $($(LineDivider_WORKSPACE_NAME)_OUTPUT) }    OUTPUT OUTPUT FEATURE_TYPE "$(LineDivider_WORKSPACE_NAME)_AttributeCreator_OUTPUT" 
